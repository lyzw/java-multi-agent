# 平台（platform-bootstrap，8080）本地开发配置模板 —— 复制为 platform.env 后填真实值
#
#   cp platform.env.example platform.env
#
# IDEA 起 platform-bootstrap：EnvFile 挂 **platform.env + jwt.env**。
# 命令行走 scripts/dev-backend.sh（它会依次 source 这两个）。
# RAG 服务的配置在 rag.env，两边不要互相 source：库不同、角色权限不同。
#
# ⚠️ 格式纪律：只允许 KEY=VALUE 与 # 注释；不要写 export、$(...)、if…fi，
#    也不要给值加引号 —— EnvFile 插件会把它们原样塞进环境。

# ⚠️ 必须是 dev（或 local/test）：非 dev profile 下缺 JWT 私钥会 fail-closed 拒绝启动。
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ── 主应用库 ─────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/agent_dev
SPRING_DATASOURCE_USERNAME=<MUST-FILL>
SPRING_DATASOURCE_PASSWORD=<MUST-FILL>
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# ── RabbitMQ（scripts/dev-rabbitmq.sh 起的本机 broker）───────────
# ⚠️ application.yml 里 spring.rabbitmq.password 默认为空，不填这里会 ACCESS_REFUSED，
#    表现为 MQ 链路不通、/actuator/health 显示 DOWN。
RABBITMQ_USER=agent
RABBITMQ_PASSWORD=<MUST-FILL>
RABBITMQ_VHOST=agent

# ── 平台运维通道（BYPASSRLS，/api/platform/v1/** 的链依赖它）──────
# 见 docs/统一配置与权限管控体系_开发计划/P6R1_平台运维角色接入说明.md
AGENT_PLATFORM_OPS_ENABLED=true
AGENT_PLATFORM_OPS_DATASOURCE_URL=jdbc:postgresql://<host>:5432/agent_dev
AGENT_PLATFORM_OPS_DATASOURCE_USERNAME=platform_ops
AGENT_PLATFORM_OPS_DATASOURCE_PASSWORD=<MUST-FILL>

# ── 模型网关（MiniMax）───────────────────────────────────────────
AGENT_MODEL_MINIMAX_API_KEY=<MUST-FILL>
AGENT_MODEL_MINIMAX_BASE_URL=https://api.minimax.cn/v1
AGENT_MODEL_MINIMAX_DEFAULT_MODEL=MiniMax-M2.5

# ⚠️ JWT 密钥不放这里：由 scripts/gen-jwt-keys.sh 生成到 jwt.env，
#    平台读私钥签发、RAG 读公钥验签，两边同源才不会「登录正常、调 RAG 全 401」。
