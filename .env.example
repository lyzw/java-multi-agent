# RAG 本地开发运行时参数模板 —— 复制为 rag-local.env 后按本机实际情况填值
#
#   cp .env.example rag-local.env
#
# `rag-local.env` 被 .gitignore 忽略（`*.env`），本模板是唯一可提交的那份。
# IDEA 起 rag-bootstrap：Run Configuration → Environment/EnvFile → 同时加载
#   ① rag-online.env（或 .env.rag-online，数据库连接）
#   ② rag-local.env（本文件对应的本机运行时参数）
#   ③ jwt-keys.env（RAG 只需其中两个公钥；由 scripts/gen-jwt-keys.sh 生成）
# 缺 ② 的表现：「本地占位端口未获显式启用，拒绝装配 EmbeddingPort →
# LocalDeterministicEmbeddingPort」——报错指向占位实现，根因是 base-url 没配。
#
# ⚠️ 格式纪律：只允许 KEY=VALUE 与 # 注释。不要写 export / $(...) / if 块，
#    shell 能过但 EnvFile 插件不认，会把整行当变量值塞进环境。

# 本地没有真实实现的端口（Docling 解析、独立 NLI）显式放行占位。
# ⚠️ 仅限本地：生产开启等同于让占位向量参与语义判定。
RAG_LOCAL_PORTS_ENABLED=true

# 真实嵌入服务（OpenAI 兼容 /v1/embeddings）。本机 Ollama 直连 11434；
# 注意有的本地代理网关只转发 chat，embeddings 会 404。
RAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
RAG_EMBEDDING_MODEL=<模型名>
RAG_EMBEDDING_API_KEY=<本地密钥>
RAG_EMBEDDING_BATCH_SIZE=8
RAG_EMBEDDING_TIMEOUT_SECONDS=300
# ⚠️ 必须与库里向量列形态一致（维度/类型不一致装配期直接拒绝启动）。
RAG_EMBEDDING_DIMENSION=4096
RAG_EMBEDDING_VECTOR_TYPE=halfvec

# 分数门禁；留空用 application.yml 的标定值（换模型或换语料必须重标，见 RAG-D08 §4）。
# RAG_RETRIEVAL_MIN_SCORE=0.38
