# ── 本地 Maven 仓库（不提交：体积大且可由 pom 还原）──
# ⚠️ 下方已有的逐文件规则只是历史产物；整目录忽略才是承重的。
/.m2repo/
/.m2-local/
admin-console/dist*

# ── 本地运行时产物（不提交：体积大且可由工具重新生成）──
# ⚠️ 清理脚本导出的备份（scripts/agent-cleanup-presets/run.sh --backup-only）
/backup/
# ⚠️ 测试散落日志（各次 mvn/容器实跑的原始输出，含库结构片段）
/tf.log
/tw.log
/tw2.log

# ── 构建产物 ──────────────────────────────────────────────
target/
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar

# ── IDE ───────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
*.swp

# ── 操作系统 ─────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── AI 工具项目数据（本地记忆与会话，不入库）──────────────
.workbuddy/
*.genie

# ── 本地环境与凭据 ───────────────────────────────────────
# 严禁提交：任何形式的凭据文件
.env
.env.local
config.env
*.env
*.env.*
*.pem
*.key
secrets/

# ── 依赖扫描产物 ─────────────────────────────────────────
dependency-check-report.*

# ── 前端（FE 阶段）────────────────────────────────────
# ⚠️ node_modules 含大量文件，误提交会撑爆仓库
node_modules/
dist/
dist-ssr/
*.local
.vite/
coverage/
test-results/
playwright-report/

# ⚠️ Vite 只暴露 VITE_ 前缀变量；此处禁止误提交任何 .env.*，
#    仅放行 .env.example 作为模板
.env.*
!*.env.example
# DDL 重导出的本地备份
*.bak-*

# ── Python 运行时产物（RAG-D26 §2.4 分块桥）──
__pycache__/
*.pyc
*.pyo

# ── 本地运行时产物（不入库）──
# 对象存储的本地桶内容（83MB 级运行时数据；语料正文不入库，只入引用）
/blobs/
# 语料对象存储的同一份本地桶的另一目录形态（rag.corpus-bucket.base-dir 默认值；
# 内容是用户上传的教材原件，同样不入库，只在 rag_source.object_ref 里留引用）
/corpus-bucket/
# 开发过程截图的临时输出目录（正式视觉稿在 rag/docs/ui-mock/screens/）
/shots/
# Docling 手工样例教材（真实教材 PDF 不入库；只保留 README §5 自造的 sample.pdf）
deploy/docling/samples/*.pdf
!deploy/docling/samples/sample.pdf
# MinerU 本地服务锁与临时测试件
.mineru-service.lock
/test_mineru.pdf
/test_mineru_out.md
/问题记录/E2E端到端测试_2026-11-10/logs/
/问题记录/E2E端到端测试_2026-11-10/screenshots/
