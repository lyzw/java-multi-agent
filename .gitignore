# ── 构建产物 ──────────────────────────────────────────────
target/
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar

# ── IDE ───────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
*.swp

# ── 操作系统 ─────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── AI 工具项目数据（本地记忆与会话，不入库）──────────────
.workbuddy/
*.genie

# ── 本地环境与凭据 ───────────────────────────────────────
# 严禁提交：任何形式的凭据文件
.env
.env.local
config.env
*.env
*.env.*
*.pem
*.key
secrets/

# ── 依赖扫描产物 ─────────────────────────────────────────
dependency-check-report.*

# ── 前端（FE 阶段）────────────────────────────────────
# ⚠️ node_modules 含大量文件，误提交会撑爆仓库
node_modules/
dist/
dist-ssr/
*.local
.vite/
coverage/
test-results/
playwright-report/

# ⚠️ Vite 只暴露 VITE_ 前缀变量；此处禁止误提交任何 .env.*，
#    仅放行 .env.example 作为模板
.env.*
!*.env.example
