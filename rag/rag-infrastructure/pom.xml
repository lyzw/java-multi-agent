<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cn.studykid.rag</groupId>
    <artifactId>java-saas-rag</artifactId>
    <version>1.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>rag-infrastructure</artifactId>
  <name>rag-infrastructure :: 非数据库基础设施层</name>
  <description>
    文档解析 / 版面还原、嵌入适配器、分词、前提后端、本地端口装配。
    ⚠️ 全部 JDBC 仓储、数据源、租户会话与 Flyway 配置已迁入 rag-persistence；
       本模块不得再声明数据库依赖，也不得反向依赖 rag-persistence（否则 Maven 成环）。
  </description>

  <dependencies>
    <dependency>
      <groupId>cn.studykid.rag</groupId>
      <artifactId>rag-core</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.studykid.rag</groupId>
      <artifactId>rag-ports</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.studykid.rag</groupId>
      <artifactId>rag-application</artifactId>
    </dependency>
    <!--
      物料前期处理 SPI（RAG-D26）：DoclingPremiseBackend 把既有解析端口
      包装成 premise 的 DocumentParseBackend（依赖方向 infrastructure → premise）。
    -->
    <dependency>
      <groupId>cn.studykid.rag</groupId>
      <artifactId>rag-premise</artifactId>
    </dependency>
    <!--
      @Configuration/@Bean/@Value 与 slf4j 原先由 spring-boot-starter-jdbc 传递带入；
      JDBC 迁走后改为显式声明，避免吃隐式 classpath（ADR-011 纪律）。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!-- 嵌入适配器解析 OpenAI 兼容 /embeddings 响应（Jackson 3，版本由 Boot BOM 管理） -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
  </dependencies>
</project>
