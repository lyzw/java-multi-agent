<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cn.studykid.rag</groupId>
    <artifactId>java-saas-rag</artifactId>
    <version>1.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>rag-infrastructure</artifactId>
  <name>rag-infrastructure :: 基础设施层</name>
  <description>pgvector 索引、文档解析、嵌入/重排适配器、PostgreSQL 持久化</description>

  <dependencies>
    <dependency>
      <groupId>cn.studykid.rag</groupId>
      <artifactId>rag-core</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.studykid.rag</groupId>
      <artifactId>rag-ports</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.studykid.rag</groupId>
      <artifactId>rag-application</artifactId>
    </dependency>
    <!--
      物料前期处理 SPI（RAG-D26）：DoclingPremiseBackend 把既有解析端口
      包装成 premise 的 DocumentParseBackend（依赖方向 infrastructure → premise）。
    -->
    <dependency>
      <groupId>cn.studykid.rag</groupId>
      <artifactId>rag-premise</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- 嵌入适配器解析 OpenAI 兼容 /embeddings 响应（Jackson 3，版本由 Boot BOM 管理） -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
  </dependencies>
</project>
