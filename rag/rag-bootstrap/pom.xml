<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cn.studykid.rag</groupId>
    <artifactId>java-saas-rag</artifactId>
    <version>1.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>rag-bootstrap</artifactId>
  <name>rag-bootstrap :: 启动与装配</name>
  <description>Spring Boot 启动装配、配置绑定、可执行制品</description>

  <dependencies>
    <dependency>
      <groupId>cn.studykid.rag</groupId>
      <artifactId>rag-api</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.studykid.rag</groupId>
      <artifactId>rag-infrastructure</artifactId>
    </dependency>
    <!--
      ⚠️ 管理面（语料登记 / 校验状态机 / 文档片段管理 / 索引统计）。
      与检索面（rag-api）并列装配：两者是**两个方向**的闸门——
      检索面回答「能召回什么」，管理面回答「库里有什么、哪些还没审、能不能放行」。
    -->
    <dependency>
      <groupId>cn.studykid.rag</groupId>
      <artifactId>rag-management</artifactId>
    </dependency>
    <!--
      ⚠️ Spring Boot 4.x 把 Flyway/Liquibase 自动配置从核心 autoconfigure 模块
      移到了各自 starter（见 Boot 4.0 迁移指南）——只引 flyway-core 不会自动迁移。
      ⛔ 当前 application.yml 里 `spring.flyway.enabled=false`：V1~V8 脚本已删除，
      结构改由 deploy/sql/rag/01_rag_ddl.sql 线下建（本 starter 因此不再产生动作）。
      保留依赖是为了恢复迁移时不必再踩 Boot 4.x 的这个坑。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- 评审 P0-2：鉴权过滤器解析 JWT claims（Jackson 3，版本由 Boot BOM 管理） -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- 评审 P0-2：鉴权过滤器测试需要 servlet mock（spring-test 随 starter-test 提供） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>cn.studykid.rag.bootstrap.RagApplication</mainClass>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
