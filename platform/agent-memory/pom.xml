<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cn.studykid.multiagent</groupId>
    <artifactId>java-saas-agent-platform</artifactId>
    <version>1.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>agent-memory</artifactId>
  <name>agent-memory :: 跨 Run 记忆特性模块（纯领域层）</name>
  <description>
    跨 Run 记忆的领域纵切：领域模型（强度衰减）、端口、召回/整合策略。
    2026-11-06 首次从五个模块收敛到本模块；同日数据库层二次收敛后，
    JdbcMemoryRepository / PgVectorAvailability / MemoryConfiguration 与连库 IT
    一并迁入 agent-persistence —— 本模块不再含任何 JDBC / 数据库依赖。

    ⚠️ 依赖方向：agent-memory 只依赖 agent-core / agent-ports / agent-application；
       agent-persistence 反向依赖本模块取得 MemoryPort 等领域类型（单向，无环）。
       agent-core / agent-ports / agent-application / agent-infrastructure
       不得反向依赖本模块。由 MemoryModuleBoundaryTest + DatabaseBoundaryTest 锁死。
  </description>

  <dependencies>
    <!-- 租户上下文 TenantContext（RLS 绑定主体）。 -->
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-core</artifactId>
    </dependency>
    <!-- 整合证据来源 ResultQueryPort#findResult（端口契约留在里层）。 -->
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-ports</artifactId>
    </dependency>
    <!--
      PromptGuard 的记忆围栏常量与 sanitize：属于通用提示词安全护栏，
      刻意不搬进本模块 —— 否则 agent-application 需反向依赖本模块，
      而本模块又依赖 application，必然成环。
    -->
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-application</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!-- ADR-011 纪律：显式声明，不吃传递依赖的隐式 classpath。 -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
    </dependency>
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-test-support</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
