<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  ConfigPointerMapper.xml —— W2 迁移，SQL 从 JdbcConfigPointerRepository 逐字搬迁
  （仅 ? → #{param}，其余 cast / ON CONFLICT / IS NOT DISTINCT FROM / 顺序全部保留）。

  ⚠️ 为什么用 IS NOT DISTINCT FROM 而不是 =（原类注释逐字保留语义）：
     首次发布时指针尚不存在、current_publish_seq IS NULL，而 expected 也是 null
     （「期望尚未发布过」是合法基线）。SQL 里 NULL = NULL 恒为 UNKNOWN，= ? 传 null
     时永远匹配不上 —— 首次发布会静默失败，且失败现场是「CAS 没生效」而非
     「首次发布语义」，排查方向完全错误。IS NOT DISTINCT FROM 把 null 当作可比较的值。

  ⚠️ 为什么不用 INSERT ... ON CONFLICT DO UPDATE ... WHERE（原类注释逐字保留语义）：
     那条语句在指针行不存在时走 INSERT 分支，若同时带 WHERE 条件，条件不满足时
     既不更新也不报错 —— 调用方分不清「CAS 失败」与「指针不存在」。本 Mapper 拆成
     「先 casUpdate，0 行且指针确实不存在时再 insertIfAbsent」，让两种结局可区分。

  ⚠️ 本文件由租户 SqlSessionFactory 加载（classpath*:mapper/tenant/**/*.xml），
     所有语句都会经过 RlsTenantBindingInterceptor。禁止挂到 ops SqlSessionFactory。
-->
<mapper namespace="cn.studykid.multiagent.infrastructure.persistence.cap.mapper.ConfigPointerMapper">

    <sql id="selectColumns">
        SELECT pointer_key, scope, tenant_id::text, current_release_id,
               current_publish_seq, updated_at
        FROM cap_config_pointer
    </sql>

    <!-- 按单键读取；tenant_id 第一道隔离由 RLS + Interceptor 保证 -->
    <select id="findByKey" resultType="cn.studykid.multiagent.infrastructure.persistence.cap.model.ConfigPointerDO">
        <include refid="selectColumns"/>
        WHERE pointer_key = #{pointerKey}
    </select>

    <!--
      第一步：基于 expected 基线的单行更新。
      ⚠️ current_publish_seq IS NOT DISTINCT FROM #{expectedPublishSeq} 不可改为 =。
    -->
    <update id="casUpdate">
        UPDATE cap_config_pointer
           SET current_release_id = #{newReleaseId}, current_publish_seq = #{newPublishSeq}, updated_at = now()
         WHERE pointer_key = #{pointerKey}
           AND current_publish_seq IS NOT DISTINCT FROM #{expectedPublishSeq}
    </update>

    <!--
      第三步：首次发布补插指针行。
      ON CONFLICT (pointer_key) DO NOTHING：并发首次发布时只有一个成功，
      另一个拿到 0 行 → CAS 失败（§6.3 第 4 条：仅一次成功）。
    -->
    <insert id="insertIfAbsent">
        INSERT INTO cap_config_pointer
            (pointer_key, scope, tenant_id, current_release_id, current_publish_seq, updated_at)
        VALUES (#{pointerKey}, #{scope}, #{tenantId}::uuid, #{newReleaseId}, #{newPublishSeq}, now())
        ON CONFLICT (pointer_key) DO NOTHING
    </insert>

</mapper>
