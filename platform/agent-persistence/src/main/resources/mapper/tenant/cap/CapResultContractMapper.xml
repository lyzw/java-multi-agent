<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  CapResultContractMapper.xml —— 四条 SQL 从 JdbcCapResultContractRepository 逐字搬迁
  （仅 ? → #{param}，其余 ::uuid / ::jsonb / ::text cast、ON CONFLICT、排序全部保留）。

  ⚠️ contract_id 是可读字符串，不是 UUID（V23 修复）：只有 tenant_id 带 ?::uuid cast；
     给 contract_id 加 ::uuid 会让非 UUID 形式的契约 id 在发布事务里直接回滚。
  ⚠️ lifecycle_state::text 必须出现在 SELECT 投影里：读不到「停用」状态绝不能被降级成
     「没有停用」（见适配层 lifecycleState 的 fail-closed 说明）。
  ⚠️ 本文件由租户 SqlSessionFactory 加载（classpath*:mapper/tenant/**/*.xml），
     所有语句都会经过 RlsTenantBindingInterceptor：适配层调用前必须先 TenantScope.bind(tenantId)。
-->
<mapper namespace="cn.studykid.multiagent.infrastructure.persistence.cap.mapper.CapResultContractMapper">

    <sql id="selectColumns">
        SELECT tenant_id::text, contract_id::text, version, schema_json::text,
               config_fingerprint, schema_version, created_at, published_at,
               lifecycle_state::text
        FROM cap_result_contract
    </sql>

    <!--
      SQL_INSERT：插入一条不可变版本行。
      ⚠️ ON CONFLICT (tenant_id, contract_id, version) DO NOTHING 而非 DO UPDATE：
         已存在同版本时不覆盖（否则在途 Run 按快照引用的旧契约会被就地改写）。
      ⚠️ schema_json 的 ?::jsonb cast 与原 JDBC 逐字一致；published_at 可空（草稿）。
    -->
    <insert id="insertVersion">
        INSERT INTO cap_result_contract
            (tenant_id, contract_id, version, schema_json, config_fingerprint,
             schema_version, created_at, published_at)
        VALUES (#{tenantId}::uuid, #{contractId}, #{version}, #{schemaJson}::jsonb,
                #{configFingerprint}, #{schemaVersion}, #{createdAt}, #{publishedAt})
        ON CONFLICT (tenant_id, contract_id, version) DO NOTHING
    </insert>

    <!-- SQL_FIND：显式 tenant_id = ?::uuid 是第一道隔离；RLS 是第二道。 -->
    <select id="find" resultType="cn.studykid.multiagent.infrastructure.persistence.cap.model.CapResultContractDO">
        <include refid="selectColumns"/>
        WHERE tenant_id = #{tenantId}::uuid AND contract_id = #{contractId} AND version = #{version}
    </select>

    <!-- SQL_FIND_LATEST_PUBLISHED：只返回已发布版本，按 version 倒序取第一行。 -->
    <select id="findLatestPublished" resultType="cn.studykid.multiagent.infrastructure.persistence.cap.model.CapResultContractDO">
        <include refid="selectColumns"/>
        WHERE tenant_id = #{tenantId}::uuid AND contract_id = #{contractId}
          AND published_at IS NOT NULL
        ORDER BY version DESC
        LIMIT 1
    </select>

    <!--
      SQL_FIND_LATEST：最新版本（<b>含草稿</b>）—— 仅用于「分配下一个版本号」。
      ⚠️ 必须含草稿：草稿也占用了版本号；只看已发布版本会分配出与草稿撞号的版本，
         插入被 ON CONFLICT DO NOTHING 静默丢弃 → 「发布成功但契约没生效」。
    -->
    <select id="findLatest" resultType="cn.studykid.multiagent.infrastructure.persistence.cap.model.CapResultContractDO">
        <include refid="selectColumns"/>
        WHERE tenant_id = #{tenantId}::uuid AND contract_id = #{contractId}
        ORDER BY version DESC
        LIMIT 1
    </select>

</mapper>
