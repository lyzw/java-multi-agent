<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>cn.studykid.multiagent</groupId>
  <artifactId>java-saas-agent-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Java SaaS Agent Platform</name>
  <description>多租户 SaaS Agent 平台 — P1 工程基线（ADR-011：Java 21 + Spring Boot 4.1.1）</description>

  <!--
    ADR-011 技术基线：
      - Java 21（DEC-4）。Spring Boot 4.x 的 JDK 基线为 17，但 jOOQ 3.20+ 要求 21，
        且 Spring AI 2.0 强制 Java 21+ / Spring Boot 4.x，三者对齐于 21。
      - Spring Boot 4.1.1（禁止 4.0.x：其 OSS 支持 2026-12-31 到期，仅剩 2 个月；
        4.1.1 支持至 2027-07-31）。v3.1 架构文档第 83 行原文为 Spring Boot 3.x，
        本次属基线偏离，已由 ADR-011 记录影响面与回滚方案。
  -->
  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- 版本基线集中管理，禁止子模块覆盖 -->
    <spring-boot.version>4.1.1</spring-boot.version>
    <jspecify.version>1.0.0</jspecify.version>
  </properties>

  <modules>
    <module>agent-core</module>
    <module>agent-ports</module>
    <module>agent-application</module>
    <module>agent-infrastructure</module>
    <module>agent-worker</module>
    <module>agent-api</module>
    <module>platform-bootstrap</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- 内部模块 -->
      <dependency>
        <groupId>cn.studykid.multiagent</groupId>
        <artifactId>agent-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.studykid.multiagent</groupId>
        <artifactId>agent-ports</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.studykid.multiagent</groupId>
        <artifactId>agent-application</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.studykid.multiagent</groupId>
        <artifactId>agent-infrastructure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.studykid.multiagent</groupId>
        <artifactId>agent-worker</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.studykid.multiagent</groupId>
        <artifactId>agent-api</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- 全模块测试基线 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.4</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${maven.compiler.release}</release>
          <compilerArgs>
            <arg>-parameters</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
