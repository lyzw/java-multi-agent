<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>cn.studykid.multiagent</groupId>
  <artifactId>java-saas-agent-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Java SaaS Agent Platform</name>
  <description>多租户 SaaS Agent 平台 — P1 工程基线（ADR-011：Java 21 + Spring Boot 4.1.1）</description>

  <!--
    ADR-011 技术基线：
      - Java 21（DEC-4）。Spring Boot 4.x 的 JDK 基线为 17，但 jOOQ 3.20+ 要求 21，
        且 Spring AI 2.0 强制 Java 21+ / Spring Boot 4.x，三者对齐于 21。
      - Spring Boot 4.1.1（禁止 4.0.x：其 OSS 支持 2026-12-31 到期，仅剩 2 个月；
        4.1.1 支持至 2027-07-31）。v3.1 架构文档第 83 行原文为 Spring Boot 3.x，
        本次属基线偏离，已由 ADR-011 记录影响面与回滚方案。
  -->
  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- 版本基线集中管理，禁止子模块覆盖 -->
    <spring-boot.version>4.1.1</spring-boot.version>
    <jspecify.version>1.0.0</jspecify.version>
  </properties>

  <modules>
    <module>agent-core</module>
    <module>agent-ports</module>
    <!--
      ⚠️ **顺序有意**：测试支撑件排在 agent-application 之前，
      因为后两者都以 test 作用域依赖它（§9 场景注册表与统一四字段断言框架）。
      Maven 本身会按依赖拓扑排序，但显式声明可读性更好。
    -->
    <module>agent-test-support</module>
    <module>agent-application</module>
    <module>agent-infrastructure</module>
    <module>agent-infra</module>
    <module>agent-worker</module>
    <module>agent-api</module>
    <module>platform-bootstrap</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- 内部模块 -->
      <dependency>
        <groupId>cn.studykid.multiagent</groupId>
        <artifactId>agent-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.studykid.multiagent</groupId>
        <artifactId>agent-ports</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.studykid.multiagent</groupId>
        <artifactId>agent-test-support</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.studykid.multiagent</groupId>
        <artifactId>agent-application</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.studykid.multiagent</groupId>
        <artifactId>agent-infrastructure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.studykid.multiagent</groupId>
        <artifactId>agent-infra</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.studykid.multiagent</groupId>
        <artifactId>agent-worker</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.studykid.multiagent</groupId>
        <artifactId>agent-api</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- 全模块测试基线 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.4</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.5.4</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${maven.compiler.release}</release>
          <compilerArgs>
            <arg>-parameters</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <!--
        ⚠️⚠️ F-14（P4-D04 实测发现）：本项目此前**没有**配置 failsafe，
        而 surefire 的默认 include 是 Test*/*Test/*Tests/*TestCase，
        不含 *IT.java —— 于是 14 个集成测试类在 `mvn verify` 中
        **一条都不会执行**，构建依然 BUILD SUCCESS。
        这是最坏的失效形态：不是「测试红」，而是「测试从未运行」。
        台账上「集成测试 N 项」在 CI 里实际等于 0。

        修复：显式注册 failsafe 并把 *IT.java 纳入 integration-test 阶段。
        IT 自身用 @EnabledIfEnvironmentVariable(IT_PG_URL) 守门——
        无数据库时**跳过**（不是失败），故 CI 无库时仍可绿，
        但「有库时」必须真跑，且跳过数会被 failsafe 报告如实记录。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*IT.java</include>
          </includes>
          <!-- ⚠️ 不设 failIfNoSpecifiedTests=false 之类放宽项：
               一旦 IT 一个都没被发现，视为构建问题而非「通过」。 -->
        </configuration>
        <executions>
          <execution>
            <id>run-integration-tests</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
