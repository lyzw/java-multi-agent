<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cn.studykid.multiagent</groupId>
    <artifactId>java-saas-agent-platform</artifactId>
    <version>1.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>agent-infrastructure</artifactId>
  <name>agent-infrastructure :: 非数据库基础设施层</name>
  <description>
    端口实现：MQ、HTTP、MCP、ModelGateway、观测与认证/授权策略等技术适配。

    ⚠️ 2026-11-06 数据库层收敛：所有 JDBC 仓储、SQL、连接/事务（含 RLS 绑定）、
       数据源与连接池配置、连库集成测试，已整体迁入独立模块 agent-persistence。
       本模块不再声明任何数据库依赖，也不得反向依赖 agent-persistence（否则成环）；
       由 DatabaseBoundaryTest 在构建期锁死。
       ADR-011 注意：Spring Boot 4.x 已模块化为 70+ starter，此处只显式引入所需模块，
       禁止依赖「统一 classpath 一定包含某类」的隐式假设。
  </description>

  <dependencies>
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-ports</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-application</artifactId>
    </dependency>
    <!-- D2 数据层权限核心领域模型（ScopeFilter / SubjectContext / Action / Decision 等）。 -->
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-core</artifactId>
    </dependency>
    <!-- D-001 IAM：JWT 载荷只反序列化到 Map/List，不绑定 POJO。 -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!-- ADR-001：RabbitMQ 4.3.6 + Quorum Queue（非数据库通道）。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
    </dependency>
    <!-- §9 场景注册表与统一四字段断言框架（单测/IT 共用同一份）。 -->
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-test-support</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
