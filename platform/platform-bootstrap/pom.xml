<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cn.studykid.multiagent</groupId>
    <artifactId>java-saas-agent-platform</artifactId>
    <version>1.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>platform-bootstrap</artifactId>
  <name>platform-bootstrap :: 启动与装配</name>
  <description>可执行应用入口、配置装配、模块组装。</description>

  <dependencies>
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-api</artifactId>
    </dependency>
    <!--
      D-001 端到端测试：RestTestClient。
      ⚠️ Spring Boot 4 把 @AutoConfigureRestTestClient 与 TestRestTemplate
         移出了 spring-boot-starter-test，须显式引入此模块。
         用 RestTestClient 而非已移除的 TestRestTemplate。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-resttestclient</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-worker</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-infrastructure</artifactId>
    </dependency>
    <!--
      跨 Run 记忆特性模块：组合根必须把它放进运行时 classpath，
      否则 MemoryConfiguration 虽在 scanBasePackages 下却根本加载不到 ——
      症状是「记忆静默关闭、无任何报错」，而 MemoryWiringTest 才会揭穿。
    -->
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-memory</artifactId>
    </dependency>
    <!--
      显式声明：本模块测试（RunRecoverySweeperTest 等）直接引用
      cn.studykid.multiagent.ports.persistence.*（如 PlatformTenantPort）。
      此前仅经 agent-infrastructure 间接传递引入，离线 -am 构建下偶发
      测试 classpath 缺失该类（NoClassDefFoundError），故显式锁定。
    -->
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-ports</artifactId>
    </dependency>
    <!--
      健康检查端点 /actuator/health。
      ⚠️ SecurityConfiguration 已将其列为匿名白名单，但此前缺依赖导致
         该端点不存在，请求落入静态资源处理器抛 500（NoResourceFoundException）。
      仅暴露 health（最小暴露面）；其余端点保持关闭。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!--
      Prometheus 指标暴露（阶段一 · P0-1c 监控面板 + 运行时灰度验证方案）。
      ⚠️ 只提供只读的 /actuator/prometheus 抓取端（见 application.yml management + SecurityConfiguration 白名单），
      供 ops 抓 cap.authz_mismatch_total / cap.tool_availability_ratio 等 Micrometer 指标，
      用于 CAP 灰度阶段 E1/E2 判定。不暴露任何配置/写端点。
    -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!--
      IT 专用租户供给器（ItTenantProvisioner）。
      ⚠️ **test 作用域**：只在 IT 里造 it- 前缀的隔离租户，不进主程序 classpath。
      此前 MessagingSwitchGuardIT 自带一份「建 tenant + agent + agent_version + execution_snapshot」
      的 SQL，与 PgQueueIT 完全重复；schema 变更时两处都要改，漏改的那处会以
      「缺快照 / 外键冲突」的面貌在别人的用例里爆炸。故收敛到共享实现。
    -->
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-test-support</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
            <configuration>
              <!--
                ⚠️⚠️ F-15（P4-D09 修复实测发现）：必须给 repackage 挂 classifier。

                现象：`platform-bootstrap` 下的**每一个** `*IT` 集成测试类
                在 `mvn verify` 中都必然报
                  「Failed to find merged annotation for @BootstrapWith」
                而 surefire（`mvn test`）跑同一个类却完全正常。

                根因（探针实测 classpath 构成）：
                  surefire : target/test-classes, **target/classes**, ...
                  failsafe : target/test-classes, **target/platform-bootstrap-x.jar**, ...
                spring-boot-maven-plugin:repackage 在 package 阶段把项目主构件
                替换成了 Spring Boot **fat jar**，其类位于 `BOOT-INF/classes/`
                那是 Spring Boot 自定义类加载器的布局，
                **普通 classloader 读不到**。于是 failsafe 侧
                `Class.forName("...PlatformApplication")` 抛 ClassNotFoundException
                → Spring 内省 `@SpringBootTest` 的 `classes` 属性时
                抛 TypeNotPresentException → 元注解 @BootstrapWith 无法内省
                → 「Failed to find merged annotation」。

                危害等级：高。它使本模块的集成测试**整体失效**，
                而构建仍报 BUILD FAILURE 之外的其它模块 SUCCESS，
                极易被误判为「测试写得不对」而改测试代码。

                修法：加 <classifier>exec</classifier>，
                使 repackage 产出 `platform-bootstrap-1.0.1-SNAPSHOT-exec.jar`（可执行胖包），
                主构件保持 thin jar（类在根目录，可被普通 classloader 读取）。
                这是 Spring Boot 官方文档给出的标准做法。
                部署时使用带 `exec` 后缀的包，见 docs/本地启动指南.md。
              -->
              <classifier>exec</classifier>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
