<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cn.studykid.multiagent</groupId>
    <artifactId>java-saas-agent-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>platform-bootstrap</artifactId>
  <name>platform-bootstrap :: 启动与装配</name>
  <description>可执行应用入口、配置装配、模块组装。</description>

  <dependencies>
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-api</artifactId>
    </dependency>
    <!--
      D-001 端到端测试：RestTestClient。
      ⚠️ Spring Boot 4 把 @AutoConfigureRestTestClient 与 TestRestTemplate
         移出了 spring-boot-starter-test，须显式引入此模块。
         用 RestTestClient 而非已移除的 TestRestTemplate。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-resttestclient</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-worker</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-infrastructure</artifactId>
    </dependency>
    <!--
      健康检查端点 /actuator/health。
      ⚠️ SecurityConfiguration 已将其列为匿名白名单，但此前缺依赖导致
         该端点不存在，请求落入静态资源处理器抛 500（NoResourceFoundException）。
      仅暴露 health（最小暴露面）；其余端点保持关闭。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
