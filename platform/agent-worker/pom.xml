<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cn.studykid.multiagent</groupId>
    <artifactId>java-saas-agent-platform</artifactId>
    <version>1.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>agent-worker</artifactId>
  <name>agent-worker :: 执行引擎</name>
  <description>
    Worker 消费、租约与 fencing、执行快照绑定、ToolOperation 账本。
    P1 阶段仅建立骨架，P2 实现。
  </description>

  <dependencies>
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-application</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-infrastructure</artifactId>
    </dependency>
    <!--
      跨 Run 记忆（P1）：RunExecutionLoop 在主循环里调用召回/整合两件套。
      ⚠️ 只依赖 agent-memory 的 application 层类型，不触碰其 persistence 包 ——
         否则等于 Worker 直连持久层（ModuleDependencyDirectionTest 会判红）。
    -->
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-memory</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
  </dependencies>
</project>
