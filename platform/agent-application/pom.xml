<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cn.studykid.multiagent</groupId>
    <artifactId>java-saas-agent-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>agent-application</artifactId>
  <name>agent-application :: 应用层</name>
  <description>
    用例编排、Run 生命周期、工具授权闸门、预算预留/结算、配置快照。
    依赖 agent-core + agent-ports；不依赖基础设施实现。
  </description>

  <dependencies>
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-core</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-ports</artifactId>
    </dependency>
    <!-- 配置属性绑定（Spring Boot 4.1 模块化 starter，按需显式引入） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!--
      W-PERM-P0：迁移期双写需要解析存量自由 JSONB（agent_version.definition）
      并投影为结构化 cap_agent_def。
      ⚠️ 只解析到 Map/List，不绑定到具体 POJO —— 存量 definition 是自由 schema
      且内容由用户写入，绑定多态类型会带来反序列化 gadget 风险（同 JwtTokenService 的处置）。
      Jackson 3（tools.jackson），随 Spring Boot 4.1 基线。
    -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
  </dependencies>
</project>
