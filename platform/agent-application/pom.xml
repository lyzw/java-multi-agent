<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cn.studykid.multiagent</groupId>
    <artifactId>java-saas-agent-platform</artifactId>
    <version>1.0.1-SNAPSHOT</version>
  </parent>

  <artifactId>agent-application</artifactId>
  <name>agent-application :: 应用层</name>
  <description>
    用例编排、Run 生命周期、工具授权闸门、预算预留/结算、配置快照。
    依赖 agent-core + agent-ports；不依赖基础设施实现。
  </description>

  <dependencies>
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-core</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-ports</artifactId>
    </dependency>
    <!--
      10 号设计 §7 债 5：路由策略的**文法与守卫**只允许有一份实现。
      应用层（发布期校验）与 worker（运行期决策）与 api（管理台 dry-run）
      都调用 agent-routing 的同一个 PolicyCodec / PublishGuards / RoutingEngine；
      任何一侧自建解析器，就会出现「发布时说合法、跑起来判不同」。
      ⚠️ agent-routing 只认识 agent-core，因此这不引入任何反向依赖。
    -->
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-routing</artifactId>
    </dependency>
    <!-- 配置属性绑定（Spring Boot 4.1 模块化 starter，按需显式引入） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!--
      W-PERM-P0：迁移期双写需要解析存量自由 JSONB（agent_version.definition）
      并投影为结构化 cap_agent_def。
      ⚠️ 只解析到 Map/List，不绑定到具体 POJO —— 存量 definition 是自由 schema
      且内容由用户写入，绑定多态类型会带来反序列化 gadget 风险（同 JwtTokenService 的处置）。
      Jackson 3（tools.jackson），随 Spring Boot 4.1 基线。
    -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
      <!--
      ⚠️ **test 作用域**：§9 场景注册表与统一四字段断言框架（§9 / §5.1）。
      单测与 IT 必须引用**同一份**注册表 —— 否则「证据路径」会分裂成两份真相。
    -->
    <dependency>
      <groupId>cn.studykid.multiagent</groupId>
      <artifactId>agent-test-support</artifactId>
      <scope>test</scope>
    </dependency>
</dependencies>
</project>
