# RAG 服务本地开发配置模板 —— 复制为 rag.env 后填真实值（rag.env 被 .gitignore 忽略）
#
#   cp rag.env.example rag.env
#
# IDEA 起 rag-bootstrap：EnvFile 挂 **rag.env + jwt.env**（jwt.env 里 RAG 只用两个公钥）。
# 平台（8080）的配置在 platform.env，两边不要互相 source：库不同、角色不同。
#
# ⚠️ 格式纪律：只允许 KEY=VALUE 与 # 注释。EnvFile 插件不认 export、$(...)、if…fi，
#    也不保证剥掉值两端的引号。

# ── PostgreSQL ───────────────────────────────────────────────────
# ⚠️ 运行时账号必须是非特权角色（NOSUPERUSER + NOBYPASSRLS）。
#    用带 BYPASSRLS 的 owner 账号（如 ai_agent）会被 RagStartupSelfCheck 拒绝启动 ——
#    那是 RLS 租户隔离的硬性保护，owner 账号只该出现在迁移脚本里。
RAG_PG_URL=jdbc:postgresql://<host>:5432/study_rag
RAG_PG_USERNAME=rag_app
RAG_PG_PASSWORD=<MUST-FILL>

# ── 平台运维通道（全局语料写，RAG-D11 第二刀）─────────────────────
# ⚠️ 默认开（RAG_OPS_ENABLED=true）。开着但 URL/USERNAME 缺失 = **拒绝启动**，
#    不是「通道不可用」：静默的哑通道会以 503 的面目长期存在，看起来像后端故障。
#    只想跑检索、不碰全局语料，就显式写 RAG_OPS_ENABLED=false。
# ⚠️ 角色必须是 rag_ops（LOGIN + BYPASSRLS，见 deploy/sql/rag/05_rag_ops_role.sql），
#    **不得与主数据源同名**——rag_ops 绕过 RLS，填进 RAG_PG_USERNAME 等于把租户隔离关掉；
#    RagStartupSelfCheck 既比配置名也比运行期 current_user，命中即拒启。
# 口令不写这里：只从环境/密钥管理注入。
RAG_OPS_ENABLED=true
RAG_OPS_DATASOURCE_URL=jdbc:postgresql://<host>:5432/study_rag
RAG_OPS_DATASOURCE_USERNAME=rag_ops
RAG_OPS_DATASOURCE_PASSWORD=<MUST-FILL>

# ── HTTP 端口（与主平台 8080 避让）───────────────────────────────
RAG_SERVER_PORT=8081

# ── 本地占位端口闸门 ─────────────────────────────────────────────
# 放行 Docling 解析 / 独立 NLI 的本地确定性占位；启动会打 ERROR 横幅。
# ⚠️ 仅限本地：生产开启等于让占位实现参与泄题判定与幻觉检测。
RAG_LOCAL_PORTS_ENABLED=true

# ── 真实嵌入模型（OpenAI 兼容 /v1/embeddings）────────────────────
# ⚠️ 缺 RAG_EMBEDDING_BASE_URL 时报错是「拒绝装配 EmbeddingPort →
#    LocalDeterministicEmbeddingPort」——文案指向占位实现，根因是这里没配。
#    照文案去设 RAG_LOCAL_PORTS_ENABLED=true 只会把问题藏起来：占位向量 1024 维，
#    下一步就被向量列维度校验拒掉。
# ⚠️ 若本机有只转发 chat 的代理网关（如 8317），embeddings 会 404，必须直连模型端口。
RAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
RAG_EMBEDDING_MODEL=<模型名>
RAG_EMBEDDING_API_KEY=<本地密钥>
RAG_EMBEDDING_BATCH_SIZE=8
RAG_EMBEDDING_TIMEOUT_SECONDS=300
# ⚠️ 这两项必须与库里向量列的实际形态一致；不一致装配期拒绝启动（deploy/sql/rag/ 有迁移）。
RAG_EMBEDDING_DIMENSION=4096
RAG_EMBEDDING_VECTOR_TYPE=halfvec

# ── 分数门禁（可选，留空用 application.yml 的标定值）─────────────
# 阈值与「嵌入模型 + 语料」绑定，换任何一个都要按 RAG-D08 §4 重标。
# RAG_RETRIEVAL_MIN_SCORE=0.38
