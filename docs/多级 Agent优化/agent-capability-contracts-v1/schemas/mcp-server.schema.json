{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example.invalid/agent-platform/mcp-server.schema.json",
  "title": "McpServerDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "status",
    "namespace",
    "transport",
    "endpoint",
    "auth",
    "trustTier",
    "dynamicDiscovery",
    "exposedToolAllowlist",
    "connectionRisk",
    "timeoutMs",
    "readTimeoutMs",
    "maxResponseBytes",
    "maxConcurrency",
    "revision"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "status": {
      "$ref": "common.schema.json#/$defs/lifecycleStatus"
    },
    "namespace": {
      "type": "string",
      "enum": [
        "platform",
        "tenant"
      ]
    },
    "tenantId": {
      "type": [
        "string",
        "null"
      ]
    },
    "transport": {
      "type": "string",
      "enum": [
        "streamable-http",
        "stdio"
      ]
    },
    "endpoint": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "maxLength": 2048
    },
    "command": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "envRefs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 256
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "bearer",
            "oauth2",
            "custom"
          ]
        },
        "credentialRef": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    },
    "trustTier": {
      "type": "string",
      "enum": [
        "internal",
        "partner",
        "public"
      ]
    },
    "dynamicDiscovery": {
      "const": false
    },
    "exposedToolAllowlist": {
      "type": [
        "array",
        "null"
      ],
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "discoveredToolsSnapshot": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "inputSchemaHash"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "inputSchemaHash": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "descriptionHash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "connectionRisk": {
      "$ref": "common.schema.json#/$defs/riskLevel"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 120000
    },
    "readTimeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 300000
    },
    "maxResponseBytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 104857600
    },
    "maxConcurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "circuitBreaker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failureThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "openDurationMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 3600000
        },
        "halfOpenMaxCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "endpointPolicyRef": {
      "type": "string",
      "minLength": 1
    },
    "configFingerprint": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "transport": {
            "const": "streamable-http"
          }
        },
        "required": [
          "transport"
        ]
      },
      "then": {
        "properties": {
          "endpoint": {
            "type": "string",
            "format": "uri"
          },
          "command": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transport": {
            "const": "stdio"
          }
        },
        "required": [
          "transport"
        ]
      },
      "then": {
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "endpoint": {
            "type": "null"
          }
        }
      }
    }
  ]
}
